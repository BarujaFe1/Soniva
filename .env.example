# Soniva does not require cloud secrets for the local-first desktop app.
# These variables are optional helpers for tooling and web demo clarity.

# Path used by drizzle-kit studio / generate against a local SQLite file.
# Example (Windows): C:\Users\You\AppData\Roaming\com.soniva.app\soniva.sqlite
SONIVA_DB_PATH=

# Optional: force the Vite web build to treat itself as demo-only (default when not in Tauri).
# VITE_SONIVA_DEMO=true
